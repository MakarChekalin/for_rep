{
  "realm": "atm-bank",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "atm-gateway",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "atm-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "atm-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@atm-bank.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "bob-admin",
      "enabled": true,
      "email": "bob-admin@atm-bank.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "bob-admin", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
