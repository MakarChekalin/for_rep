<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
  </PropertyGroup>

  <!-- No patched release is available yet for these OpenTelemetry advisories -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4625-4j76-fww9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8785-wc3w-h8q6" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Itmo.Dev.Platform.Kafka" />
    <PackageReference Include="Itmo.Dev.Platform.MessagePersistence" />
    <PackageReference Include="Itmo.Dev.Platform.MessagePersistence.Postgres" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atm.Application\Atm.Application.csproj" />
    <ProjectReference Include="..\Atm.Infrastructure\Atm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\common\Atm.ServiceDefaults\Atm.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\**\*.proto" Exclude="Protos\Kafka\google\**\*.proto" GrpcServices="Both" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
