{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "Infrastructure",
    "InvoiceApprovalService",
    "MessagePersistence"
  ],
  "properties": {
    "Infrastructure": {
      "allOf": [
        {
          "required": [
            "Persistence"
          ],
          "properties": {
            "Persistence": {
              "allOf": [
                {
                  "required": [
                    "Postgres"
                  ],
                  "properties": {
                    "Postgres": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Persistence_Postgres_Models_PostgresConnectionOptions"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "InvoiceApprovalService": {
      "allOf": [
        {
          "$ref": "#/definitions/Atm_Grpc_Integrations_InvoiceApprovalClientOptions"
        }
      ]
    },
    "MessagePersistence": {
      "allOf": [
        {
          "required": [
            "Postgres",
            "Publisher"
          ],
          "properties": {
            "Postgres": {
              "allOf": [
                {
                  "$ref": "#/definitions/Itmo_Dev_Platform_MessagePersistence_Postgres_Configuration_MessagePersistencePostgresOptions"
                }
              ]
            },
            "Publisher": {
              "allOf": [
                {
                  "required": [
                    "Default"
                  ],
                  "properties": {
                    "Default": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_MessagePersistence_Options_MessagePersistencePublisherOptions"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "Itmo_Dev_Platform_Persistence_Postgres_Models_PostgresConnectionOptions": {
      "type": "object",
      "required": [
        "Host",
        "Port",
        "Database",
        "Username",
        "Password"
      ],
      "properties": {
        "Host": {
          "type": "string",
          "minLength": 1
        },
        "Port": {
          "type": "integer",
          "format": "int32",
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "Database": {
          "type": "string",
          "minLength": 1
        },
        "Username": {
          "type": "string",
          "minLength": 1
        },
        "Password": {
          "type": "string",
          "minLength": 1
        },
        "SslMode": {
          "type": "string"
        },
        "Pooling": {
          "type": "boolean",
          "default": true
        },
        "MaximumPoolSize": {
          "type": "integer",
          "format": "int32",
          "default": 10,
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "EnableConnectionProviderLogging": {
          "type": "boolean"
        }
      }
    },
    "Atm_Grpc_Integrations_InvoiceApprovalClientOptions": {
      "type": "object",
      "properties": {
        "BaseUrl": {
          "type": "string"
        }
      }
    },
    "Itmo_Dev_Platform_MessagePersistence_Postgres_Configuration_MessagePersistencePostgresOptions": {
      "type": "object",
      "required": [
        "SchemaName"
      ],
      "properties": {
        "SchemaName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Itmo_Dev_Platform_MessagePersistence_Options_MessagePersistencePublisherOptions": {
      "type": "object",
      "properties": {
        "BatchSize": {
          "type": "integer",
          "format": "int32",
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "PollingDelay": {
          "type": "string",
          "pattern": "^-?(\\d+\\.)?([01]?\\d|2[0-3]):([0-5]?\\d):([0-5]?\\d)(\\.\\d{1,7})?$"
        }
      }
    }
  }
}